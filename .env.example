# Cortex Environment Configuration Template
# Copy this file to .env:
# cp .env.example .env

# Optional: Google Gemini API Key for online multimodal reasoning
# If left blank, Cortex will seamlessly run in local offline fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Encryption Key (auto-generated if omitted)
# CORTEX_ENCRYPTION_KEY=
